config_version=5

[application]
config/name="Aetherforge — Protótipo M0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=680
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=1

[dotnet]
project/assembly_name="Aetherforge.Client"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.045, 0.055, 0.065, 1)

[physics]
common/physics_ticks_per_second=20
